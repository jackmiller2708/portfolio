---
import "@styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Menu, Moon, Sun, X } from "lucide-astro";
import { Font } from "astro:assets";
import type { PageSeo } from "@domain/site";
import type { Locale } from "@domain/site";
import { alternateLocale, t } from "@i18n/locales";

type Props = {
  title?: string;
  description?: string;
  seo?: PageSeo;
  locale?: Locale;
  routePath?: string;
};

const { title, description, seo, locale = "en", routePath = Astro.url.pathname } = Astro.props;
const copy = t(locale);
const pageTitle = seo?.title ?? title ?? "Nguyen Ngoc Huy / Jack";
const pageDescription =
  seo?.description ??
  description ??
  "Vietnam-based Angular Frontend Systems Engineer for audits, refactors, and stabilization.";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const localeUrl = (targetLocale: Locale, path: string) => {
  const normalizedPath = path === "/" ? "" : path.replace(/^\/+/, "");

  return getRelativeLocaleUrl(targetLocale, normalizedPath);
};
const homePath = localeUrl(locale, "/");
const languagePath = localeUrl(alternateLocale(locale), routePath);
const isHomeActive = currentPath === (homePath.replace(/\/$/, "") || "/");

const navItems = [
  { label: copy.nav.services, href: localeUrl(locale, "/services") },
  { label: copy.nav.caseStudies, href: localeUrl(locale, "/case-studies") },
  { label: copy.nav.lab, href: localeUrl(locale, "/lab") },
  { label: copy.nav.sampleAudit, href: localeUrl(locale, "/sample-audit") },
  { label: copy.nav.about, href: localeUrl(locale, "/about") },
  { label: copy.nav.contact, href: localeUrl(locale, "/contact") }
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {seo && <link rel="canonical" href={seo.canonicalUrl} />}
    {seo && <meta property="og:title" content={seo.ogTitle} />}
    {seo && <meta property="og:description" content={seo.ogDescription} />}
    {seo && <meta property="og:image" content={seo.ogImage} />}
    {seo && <meta property="og:url" content={seo.ogUrl} />}
    {seo && <meta property="og:type" content="website" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-code" />
    <Font cssVariable="--font-body" />
    <script is:inline>
      document.documentElement.classList.add("has-js");
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="u-skip-link" href="#main"
      >{locale === "vi" ? "Bỏ qua điều hướng" : "Skip to content"}</a
    >
    <header class="site-header">
      <div class="site-header__inner u-container">
        <div class="site-header__bar">
          <a
            class:list={["site-header__brand", isHomeActive && "is-active"]}
            href={homePath}
            aria-current={isHomeActive ? "page" : undefined}
          >
            <span class="site-header__brand-name">Nguyen Ngoc Huy / Jack Miller</span>
            <span class="site-header__brand-role">Angular Frontend Systems Engineer</span>
          </a>
          <div class="site-header__controls">
            <button
              class="site-header__theme"
              type="button"
              data-theme-toggle
              aria-label={copy.header.switchTheme}
            >
              <Sun
                class="site-header__theme-icon site-header__theme-icon--sun"
                size={16}
                aria-hidden="true"
              />
              <Moon
                class="site-header__theme-icon site-header__theme-icon--moon"
                size={16}
                aria-hidden="true"
              />
              <span data-theme-label>Theme</span>
            </button>
            <a class="site-header__language" href={languagePath} hreflang={alternateLocale(locale)}>
              {copy.header.language}
            </a>
            <button
              class="site-header__menu-toggle"
              type="button"
              data-nav-toggle
              data-open-label={copy.header.openNav}
              data-close-label={copy.header.closeNav}
              aria-controls="site-navigation"
              aria-expanded="false"
              aria-label={copy.header.openNav}
            >
              <Menu
                class="site-header__menu-icon site-header__menu-icon--open"
                size={18}
                aria-hidden="true"
              />
              <X
                class="site-header__menu-icon site-header__menu-icon--close"
                size={18}
                aria-hidden="true"
              />
            </button>
          </div>
        </div>
        <nav
          id="site-navigation"
          class="site-header__nav"
          aria-label={locale === "vi" ? "Điều hướng chính" : "Primary navigation"}
        >
          {
            navItems.map((item) => {
              const normalizedHref = item.href.replace(/\/$/, "") || "/";
              const isActive =
                currentPath === normalizedHref ||
                (normalizedHref !== "/" && currentPath.startsWith(`${normalizedHref}/`));

              return (
                <a
                  class:list={[isActive && "is-active"]}
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: var(--border-1);
    backdrop-filter: blur(14px);
    transition:
      background-color 400ms var(--ease-gentle),
      border-color 400ms var(--ease-gentle);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(220px, auto) minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-6);
    min-height: 64px;
  }

  .site-header__bar {
    display: contents;
  }

  .site-header__controls {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__brand {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 8px;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--t-brand);
    font-weight: 300;
    line-height: 1;
    text-decoration: none;
  }

  .site-header__brand-name {
    font-weight: 500;
  }

  .site-header__brand-role {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--t-mono);
    font-weight: 600;
  }

  .site-header__brand.is-active .site-header__brand-name {
    color: var(--color-accent);
  }

  .site-header__brand,
  .site-header__nav a,
  .site-header__language,
  .site-header__theme,
  .site-header__menu-toggle {
    transition:
      background-color var(--duration-1) var(--ease-standard),
      color var(--duration-1) var(--ease-standard),
      border-color var(--duration-1) var(--ease-standard),
      transform var(--duration-1) var(--ease-spring);
  }

  .site-header__nav {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: clamp(var(--space-2), 1.4vw, var(--space-4));
    min-width: 0;
  }

  .site-header__nav a {
    position: relative;
    padding-block: var(--space-2);
    color: var(--color-muted);
    font-size: clamp(0.82rem, 0.9vw, 0.94rem);
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }

  .site-header__nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-spring);
  }

  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    color: var(--color-accent);
  }

  .site-header__nav a.is-active::after {
    transform: scaleX(1);
  }

  .site-header__theme {
    grid-column: 3;
    grid-row: 1;
    display: none;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    width: calc(5ch + 2.5rem);
    padding: var(--control-padding-y) var(--control-padding-x);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
    cursor: pointer;
    font-size: var(--t-small);
    font-weight: 700;
  }

  /* The toggle has no effect and no icon state without JS (both depend on
     the script below), so it only renders once script confirms it can run. */
  :root.has-js .site-header__theme {
    display: inline-flex;
  }

  .site-header__language {
    grid-column: 4;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--control-padding-y) var(--control-padding-x);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
    font-size: var(--t-small);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .site-header__language:hover {
    border-color: var(--color-border-accent);
  }

  .site-header__theme span {
    height: 13px;
  }

  .site-header__menu-toggle {
    display: none;
  }

  .site-header__theme:hover,
  .site-header__menu-toggle:hover {
    border-color: var(--color-border-accent);
  }

  .site-header__theme-icon {
    flex: 0 0 auto;
    opacity: 0;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform 300ms var(--ease-in-out-quart);
  }

  .site-header__theme-icon--moon {
    display: none;
  }

  .site-header__theme[data-theme-state="light"] .site-header__theme-icon--sun,
  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--moon {
    opacity: 1;
  }

  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--sun {
    display: none;
  }

  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--moon {
    display: block;
  }

  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--moon,
  .site-header__theme[data-theme-state="light"] .site-header__theme-icon--sun {
    transform: rotate(180deg);
  }

  @media (max-width: 999px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      min-height: 0;
    }

    .site-header__bar {
      grid-column: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      min-height: 56px;
      width: 100%;
    }

    .site-header__brand,
    .site-header__controls {
      min-width: 0;
    }

    .site-header {
      --t-brand: 1rem;
    }

    .site-header__brand {
      grid-column: auto;
    }

    .site-header__brand-role {
      font-size: var(--t-mono);
    }

    .site-header__theme {
      grid-column: auto;
      flex-shrink: 0;
      width: 44px;
      min-height: 44px;
      padding: var(--control-padding-y);
    }

    .site-header__language {
      min-width: 0;
      min-height: 44px;
      padding: var(--control-padding-y) clamp(0.4rem, 1.8vw, 0.75rem);
    }

    .site-header__theme span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    :root.has-js .site-header__menu-toggle {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 44px;
      min-height: 44px;
      color: var(--color-text);
      background: var(--color-surface);
      border: var(--border-1);
      border-radius: var(--radius-1);
      cursor: pointer;
    }

    .site-header__menu-icon--close,
    .site-header.is-menu-open .site-header__menu-icon--open {
      display: none;
    }

    .site-header.is-menu-open .site-header__menu-icon--close {
      display: block;
    }

    .site-header__nav {
      grid-column: 1;
      grid-row: auto;
      display: grid;
      width: 100%;
      padding: var(--space-2) 0 var(--space-3);
      border-top: var(--border-1);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    /* Without JS, .is-menu-open never gets toggled, so the nav must stay
       visible by default; only collapse it once script confirms it can
       also open it again. */
    :root.has-js .site-header__nav {
      max-height: 0;
      padding: 0;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      visibility: hidden;
      transition:
        max-height var(--duration-base) var(--ease-out-expo),
        opacity var(--duration-fast) var(--ease-standard),
        padding var(--duration-fast) var(--ease-standard),
        visibility var(--duration-fast) var(--ease-standard);
    }

    :root.has-js .site-header.is-menu-open .site-header__nav {
      max-height: 180px;
      padding: var(--space-2) 0 var(--space-3);
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .site-header__nav a {
      min-height: 40px;
      padding: var(--space-2) 0;
      font-size: var(--t-small);
    }

    .site-header__nav a::after {
      right: var(--space-4);
    }
  }
</style>

<script>
  import "../scripts/interactions";
</script>

<script>
  const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)");

  const applyStoredTheme = () => {
    const storedTheme = localStorage.getItem("theme");

    if (storedTheme === "light" || storedTheme === "dark") {
      document.documentElement.dataset.theme = storedTheme;
    }
  };

  const getResolvedTheme = () =>
    document.documentElement.dataset.theme || (systemPrefersDark.matches ? "dark" : "light");

  const setThemeLabel = (themeToggle: HTMLButtonElement) => {
    const themeLabel = themeToggle.querySelector<HTMLElement>("[data-theme-label]");
    const resolvedTheme = getResolvedTheme();

    themeToggle.dataset.themeState = resolvedTheme;

    if (themeLabel) {
      themeLabel.textContent = resolvedTheme === "dark" ? "Light" : "Dark";
    }
  };

  const initThemeToggle = () => {
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

    if (!themeToggle) {
      return;
    }

    setThemeLabel(themeToggle);

    if (themeToggle.dataset.themeReady === "true") {
      return;
    }

    themeToggle.dataset.themeReady = "true";
    themeToggle.addEventListener("click", () => {
      const nextTheme = getResolvedTheme() === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("theme", nextTheme);
      setThemeLabel(themeToggle);
    });
  };

  const initMobileNavigation = () => {
    const siteHeader = document.querySelector<HTMLElement>(".site-header");
    const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const nav = document.querySelector<HTMLElement>("#site-navigation");

    if (!siteHeader || !navToggle || !nav) {
      return;
    }

    if (navToggle.dataset.navReady === "true") {
      return;
    }

    const setOpen = (isOpen: boolean) => {
      siteHeader.classList.toggle("is-menu-open", isOpen);
      navToggle.setAttribute("aria-expanded", String(isOpen));
      const openLabel = navToggle.dataset.openLabel ?? "Open navigation";
      const closeLabel = navToggle.dataset.closeLabel ?? "Close navigation";
      navToggle.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
    };

    navToggle.dataset.navReady = "true";
    navToggle.addEventListener("click", () => {
      setOpen(!siteHeader.classList.contains("is-menu-open"));
    });

    nav.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && siteHeader.classList.contains("is-menu-open")) {
        setOpen(false);
        navToggle.focus();
      }
    });

    window.matchMedia("(min-width: 1000px)").addEventListener("change", (event) => {
      if (event.matches) {
        setOpen(false);
      }
    });
  };

  systemPrefersDark.addEventListener("change", initThemeToggle);
  document.addEventListener("astro:after-swap", applyStoredTheme);
  document.addEventListener("DOMContentLoaded", () => {
    initThemeToggle();
    initMobileNavigation();
  });
  document.addEventListener("astro:page-load", () => {
    initThemeToggle();
    initMobileNavigation();
  });
  applyStoredTheme();
  initThemeToggle();
  initMobileNavigation();
</script>
