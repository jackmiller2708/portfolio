---
import "@styles/global.css";
import { Moon, Sun } from "lucide-astro";
import type { PageSeo } from "@domain/site";

type Props = {
  title?: string;
  description?: string;
  seo?: PageSeo;
};

const { title, description, seo } = Astro.props;
const pageTitle = seo?.title ?? title ?? "Frontend Systems Portfolio";
const pageDescription = seo?.description ?? description ?? "Angular frontend systems engineering.";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: "Services", href: "/services" },
  { label: "Case Studies", href: "/case-studies" },
  { label: "Lab", href: "/lab" },
  { label: "Sample Audit", href: "/sample-audit" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {seo && <link rel="canonical" href={seo.canonicalUrl} />}
    {seo && <meta property="og:title" content={seo.ogTitle} />}
    {seo && <meta property="og:description" content={seo.ogDescription} />}
    {seo && <meta property="og:image" content={seo.ogImage} />}
    {seo && <meta property="og:url" content={seo.ogUrl} />}
    {seo && <meta property="og:type" content="website" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      const fontStylesheet = document.createElement("link");
      fontStylesheet.rel = "stylesheet";
      fontStylesheet.href =
        "https://fonts.googleapis.com/css2?family=Epilogue:wght@300;400;700;800&family=Fraunces:opsz,wght,SOFT,WONK@9..144,300,0,0..1&family=IBM+Plex+Mono:wght@400;500&display=swap";
      document.head.append(fontStylesheet);
    </script>
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Epilogue:wght@300;400;700;800&family=Fraunces:opsz,wght,SOFT,WONK@9..144,300,0,0..1&family=IBM+Plex+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="u-skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner u-container">
        <a class="site-header__brand" href="/">Frontend Systems</a>
        <nav class="site-header__nav" aria-label="Primary navigation">
          {
            navItems.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== "/" && currentPath.startsWith(`${item.href}/`));

              return (
                <a
                  class:list={[isActive && "is-active"]}
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <button
          class="site-header__theme"
          type="button"
          data-theme-toggle
          aria-label="Switch theme"
        >
          <Sun
            class="site-header__theme-icon site-header__theme-icon--sun"
            size={16}
            aria-hidden="true"
          />
          <Moon
            class="site-header__theme-icon site-header__theme-icon--moon"
            size={16}
            aria-hidden="true"
          />
          <span data-theme-label>Theme</span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: var(--border-1);
    backdrop-filter: blur(14px);
    transition:
      background-color 400ms var(--ease-gentle),
      border-color 400ms var(--ease-gentle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
  }

  .site-header__brand {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1;
    text-decoration: none;
  }

  .site-header__brand,
  .site-header__nav a,
  .site-header__theme {
    transition:
      background-color var(--duration-1) var(--ease-standard),
      color var(--duration-1) var(--ease-standard),
      border-color var(--duration-1) var(--ease-standard),
      transform var(--duration-1) var(--ease-spring);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  .site-header__nav a {
    position: relative;
    padding-block: var(--space-2);
    color: var(--color-muted);
    font-size: 0.94rem;
    font-weight: 400;
    text-decoration: none;
  }

  .site-header__nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-spring);
  }

  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    color: var(--color-accent);
  }

  .site-header__nav a.is-active::after {
    transform: scaleX(1);
  }

  .site-header__theme {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 38px;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
    cursor: pointer;
    font-size: var(--t-small);
    font-weight: 700;
  }

  .site-header__theme:hover {
    border-color: var(--color-border-accent);
  }

  .site-header__theme-icon {
    flex: 0 0 auto;
    opacity: 0;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform 300ms var(--ease-in-out-quart);
  }

  .site-header__theme-icon--moon {
    display: none;
  }

  .site-header__theme[data-theme-state="light"] .site-header__theme-icon--sun,
  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--moon {
    opacity: 1;
  }

  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--sun {
    display: none;
  }

  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--moon {
    display: block;
  }

  .site-header__theme[data-theme-state="dark"] .site-header__theme-icon--moon,
  .site-header__theme[data-theme-state="light"] .site-header__theme-icon--sun {
    transform: rotate(180deg);
  }

  @media (max-width: 760px) {
    .site-header__inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--space-4);
    }

    .site-header__nav {
      justify-content: flex-start;
    }
  }
</style>

<script>
  import "../scripts/interactions";
</script>

<script>
  const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)");

  const applyStoredTheme = () => {
    const storedTheme = localStorage.getItem("theme");

    if (storedTheme === "light" || storedTheme === "dark") {
      document.documentElement.dataset.theme = storedTheme;
    }
  };

  const getResolvedTheme = () =>
    document.documentElement.dataset.theme || (systemPrefersDark.matches ? "dark" : "light");

  const setThemeLabel = (themeToggle: HTMLButtonElement) => {
    const themeLabel = themeToggle.querySelector<HTMLElement>("[data-theme-label]");
    const resolvedTheme = getResolvedTheme();

    themeToggle.dataset.themeState = resolvedTheme;

    if (themeLabel) {
      themeLabel.textContent = resolvedTheme === "dark" ? "Light" : "Dark";
    }
  };

  const initThemeToggle = () => {
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

    if (!themeToggle) {
      return;
    }

    setThemeLabel(themeToggle);

    if (themeToggle.dataset.themeReady === "true") {
      return;
    }

    themeToggle.dataset.themeReady = "true";
    themeToggle.addEventListener("click", () => {
      const nextTheme = getResolvedTheme() === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("theme", nextTheme);
      setThemeLabel(themeToggle);
    });
  };

  systemPrefersDark.addEventListener("change", initThemeToggle);
  document.addEventListener("astro:after-swap", applyStoredTheme);
  document.addEventListener("DOMContentLoaded", initThemeToggle);
  document.addEventListener("astro:page-load", initThemeToggle);
  applyStoredTheme();
  initThemeToggle();
</script>
