---
import "@styles/global.css";
import type { PageSeo } from "@domain/site";

type Props = {
  title?: string;
  description?: string;
  seo?: PageSeo;
};

const { title, description, seo } = Astro.props;
const pageTitle = seo?.title ?? title ?? "Frontend Systems Portfolio";
const pageDescription = seo?.description ?? description ?? "Angular frontend systems engineering.";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: "Services", href: "/services" },
  { label: "Case Studies", href: "/case-studies" },
  { label: "Lab", href: "/lab" },
  { label: "Sample Audit", href: "/sample-audit" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {seo && <link rel="canonical" href={seo.canonicalUrl} />}
    {seo && <meta property="og:title" content={seo.ogTitle} />}
    {seo && <meta property="og:description" content={seo.ogDescription} />}
    {seo && <meta property="og:image" content={seo.ogImage} />}
    {seo && <meta property="og:url" content={seo.ogUrl} />}
    {seo && <meta property="og:type" content="website" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="u-skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner u-container">
        <a class="site-header__brand" href="/">Frontend Systems</a>
        <nav class="site-header__nav" aria-label="Primary navigation">
          {
            navItems.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== "/" && currentPath.startsWith(`${item.href}/`));

              return (
                <a
                  class:list={[isActive && "is-active"]}
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-bottom: var(--border-1);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
  }

  .site-header__brand {
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__brand,
  .site-header__nav a {
    transition:
      color var(--duration-1) var(--ease-standard),
      border-color var(--duration-1) var(--ease-standard);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  .site-header__nav a {
    padding-block: var(--space-2);
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    font-size: 0.94rem;
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    color: var(--color-text);
  }

  .site-header__nav a.is-active {
    border-color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .site-header__inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--space-4);
    }

    .site-header__nav {
      justify-content: flex-start;
    }
  }
</style>
