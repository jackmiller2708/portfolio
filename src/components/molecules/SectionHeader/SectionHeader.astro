---
type Props = {
  eyebrow?: string;
  title: string;
  summary?: string;
};

const { title, summary } = Astro.props;
---

<header class="section-header">
  <h2>{title}</h2>
  {summary && <p class="section-header__summary">{summary}</p>}
</header>

<style>
  .section-header {
    max-width: 760px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.12;
  }

  .section-header__summary {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: var(--t-h4);
    max-width: 68ch;
  }
</style>
