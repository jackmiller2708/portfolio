---
type Props = {
  eyebrow?: string;
  title: string;
  summary?: string;
};

const { title, summary } = Astro.props;
---

<header class="section-header">
  <h2>{title}</h2>
  {summary && <p class="section-header__summary">{summary}</p>}
</header>

<style>
  .section-header {
    max-width: 760px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.08;
  }

  .section-header__summary {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: 1.1rem;
    max-width: 68ch;
  }

  @media (min-width: 720px) {
    h2 {
      font-size: 3.25rem;
    }
  }
</style>
