---
import ButtonLink from "@components/primitives/ButtonLink/ButtonLink.astro";

type Props = {
  eyebrow?: string;
  title: string;
  summary: string;
  primaryCta?: {
    label: string;
    href: string;
  };
  secondaryCta?: {
    label: string;
    href: string;
  };
};

const { eyebrow, title, summary, primaryCta, secondaryCta } = Astro.props;
const [firstLine, ...restTitle] = title.split("\n");
const secondLine = restTitle.join(" ");
const isDisplayHero = Boolean(secondLine);
---

<section class:list={["page-hero", isDisplayHero && "page-hero--display"]}>
  <div class="page-hero__inner u-container">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1>
      {
        secondLine ? (
          <>
            <span>{firstLine}</span>
            <em>{secondLine}</em>
          </>
        ) : (
          title
        )
      }
    </h1>
    <p class="page-hero__summary">{summary}</p>
    {
      (primaryCta || secondaryCta) && (
        <div class="page-hero__actions">
          {primaryCta && <ButtonLink href={primaryCta.href} label={primaryCta.label} />}
          {secondaryCta && (
            <ButtonLink href={secondaryCta.href} label={secondaryCta.label} variant="secondary" />
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    contain: layout style;
    padding: var(--space-12) 0 var(--space-10);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-5);
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-hero);
    font-weight: 300;
    line-height: 1.05;
  }

  .page-hero:not(.page-hero--display) h1 {
    font-family: var(--font-body);
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.12;
  }

  h1 span,
  h1 em {
    display: block;
  }

  h1 em {
    font-style: italic;
  }

  .page-hero__summary {
    max-width: 72ch;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--t-h4);
    line-height: 1.65;
  }

  .page-hero__eyebrow {
    max-width: 72ch;
    margin: 0;
    color: var(--color-text);
    font-size: var(--t-small);
    font-weight: 700;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (min-width: 720px) {
    .page-hero {
      padding: var(--space-16) 0 var(--space-12);
    }
  }
</style>
