---
type CredibilityPoint = {
  readonly label: string;
  readonly value: string;
  readonly detail: string;
};

type Props = {
  points: readonly CredibilityPoint[];
};

const { points } = Astro.props;
---

<section class="credibility-strip" aria-label="Credibility signals">
  <div class="credibility-strip__inner u-container">
    <ul>
      {
        points.map((point) => (
          <li>
            <p class="credibility-strip__label">{point.label}</p>
            <strong>{point.value}</strong>
            <p>{point.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .credibility-strip {
    padding: var(--space-5) 0;
    background: var(--color-surface);
    border-block: var(--border-1);
  }

  ul {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    min-width: 0;
  }

  .credibility-strip__label,
  p {
    margin: 0;
    color: var(--color-muted);
  }

  .credibility-strip__label {
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 500;
    text-transform: uppercase;
  }

  strong {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.25;
  }

  li > p:not(.credibility-strip__label) {
    grid-column: 2;
    font-size: var(--t-small);
  }

  @media (min-width: 820px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
