---
import type { AuditFinding } from "@domain/audit";

type Props = {
  finding: AuditFinding;
};

const { finding } = Astro.props;
---

<article class="audit-finding">
  <div class="audit-finding__header">
    <p class="audit-finding__severity" data-severity={finding.severity}>{finding.severity}</p>
    <h3>{finding.title}</h3>
  </div>
  <p><strong>Evidence:</strong> {finding.evidence}</p>
  <p><strong>Risk:</strong> {finding.risk}</p>
  <p><strong>Recommendation:</strong> {finding.recommendation}</p>
</article>

<style>
  .audit-finding {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
    transition: border-color var(--duration-state) var(--ease-standard);
  }

  .audit-finding:hover {
    border-color: var(--color-accent);
  }

  .audit-finding__header {
    display: grid;
    gap: var(--space-2);
  }

  .audit-finding__severity {
    width: fit-content;
    margin: 0;
    padding: calc(var(--space-1) + 5px) var(--space-3) var(--space-1) var(--space-3);
    line-height: 1;
    border-radius: var(--radius-1);
    font-weight: 700;
    text-transform: capitalize;
  }

  .audit-finding__severity[data-severity="critical"] {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 32%, transparent);
  }

  .audit-finding__severity[data-severity="high"] {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 32%, transparent);
  }

  .audit-finding__severity[data-severity="medium"] {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 32%, transparent);
  }

  .audit-finding__severity[data-severity="low"] {
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-muted) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-muted) 32%, transparent);
  }

  h3,
  p {
    margin: 0;
  }

  p {
    color: var(--color-muted);
  }

  strong {
    color: var(--color-text);
  }
</style>
