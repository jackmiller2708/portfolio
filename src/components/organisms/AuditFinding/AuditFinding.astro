---
import type { AuditFinding } from "@domain/audit";

type Props = {
  finding: AuditFinding;
};

const { finding } = Astro.props;
---

<article class="audit-finding">
  <div class="audit-finding__header">
    <p class="audit-finding__severity">{finding.severity}</p>
    <h3>{finding.title}</h3>
  </div>
  <p><strong>Evidence:</strong> {finding.evidence}</p>
  <p><strong>Risk:</strong> {finding.risk}</p>
  <p><strong>Recommendation:</strong> {finding.recommendation}</p>
</article>

<style>
  .audit-finding {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .audit-finding__header {
    display: grid;
    gap: var(--space-2);
  }

  .audit-finding__severity {
    width: fit-content;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-danger) 32%, transparent);
    border-radius: var(--radius-1);
    font-weight: 700;
    text-transform: capitalize;
  }

  h3,
  p {
    margin: 0;
  }

  p {
    color: var(--color-muted);
  }

  strong {
    color: var(--color-text);
  }
</style>
