---
import ButtonLink from "@components/primitives/ButtonLink/ButtonLink.astro";
import type { ServiceOffer } from "@domain/service";

type Props = {
  service: ServiceOffer;
};

const { service } = Astro.props;
---

<article class="service-card">
  <div>
    <h2>{service.title}</h2>
    <p>{service.summary}</p>
  </div>
  <dl>
    <div>
      <dt>Situation</dt>
      <dd>{service.clientPain}</dd>
    </div>
    <div>
      <dt>Output</dt>
      <dd>{service.outputs.join(", ")}</dd>
    </div>
    <div>
      <dt>Good fit</dt>
      <dd>{service.bestFit.join("; ")}</dd>
    </div>
    <div>
      <dt>Not fit</dt>
      <dd>{service.notFit.join("; ")}</dd>
    </div>
  </dl>
  <ButtonLink href={service.cta.href} label={service.cta.label} />
</article>

<style>
  .service-card {
    display: grid;
    align-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
    transition:
      border-color var(--duration-fast) var(--ease-out-quint),
      transform var(--duration-fast) var(--ease-out-quint);
  }

  .service-card:hover {
    border-color: var(--color-border-accent);
    transform: translateY(-3px);
  }

  h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.15;
  }

  p {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
  }

  dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  dt {
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 500;
    text-transform: uppercase;
  }

  dd {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card:hover {
      transform: none;
    }
  }
</style>
