---
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import ContactIntake from "@islands/ContactIntake/ContactIntake.astro";
import { loadContactPage } from "@programs/load-contact-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";

const viewModel = await Effect.runPromise(loadContactPage);
const site = await Effect.runPromise(astroContentRepository.getSiteMeta);
const seo = buildPageSeo(site, {
  path: "/contact",
  title: "Contact",
  description: "Start a scoped frontend systems diagnostic."
});
---

<BaseLayout seo={seo}>
  <PageHero title={viewModel.title} summary={viewModel.summary} />
  <section class="contact-section">
    <div class="u-container contact-layout">
      <ContactIntake viewModel={viewModel} />
      <aside class="fit-note" aria-labelledby="contact-boundaries">
        <h2 id="contact-boundaries">Before sending</h2>
        <p>These requests are usually not a fit for this diagnostic path.</p>
        <ul>{viewModel.nonFitCriteria.map((item) => <li>{item}</li>)}</ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding: 0 0 var(--space-16);
  }

  .contact-layout {
    display: grid;
    gap: var(--space-8);
  }

  .fit-note {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .fit-note h2,
  .fit-note p {
    margin: 0;
  }

  .fit-note h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
  }

  .fit-note p,
  .fit-note ul {
    color: var(--color-muted);
  }

  @media (min-width: 980px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }
  }
</style>
