---
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import { loadContactPage } from "@programs/load-contact-page";

const viewModel = await Effect.runPromise(loadContactPage);
---

<BaseLayout
  title="Contact | Frontend Systems Portfolio"
  description="Start a scoped frontend systems diagnostic."
>
  <PageHero title={viewModel.title} summary={viewModel.summary} />
  <section class="contact-section">
    <form class="contact-form u-container" method="post">
      <p class="contact-form__availability">{viewModel.availability}</p>
      <label>
        Name
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Product or company context
        <input name="productContext" required />
      </label>
      <label>
        Angular version or frontend stack
        <input name="angularVersion" required />
      </label>
      <label>
        Team size
        <input name="teamSize" required />
      </label>
      <label>
        Main pain
        <textarea name="pain" rows="5" required></textarea>
      </label>
      <label>
        Engagement type
        <select name="engagementType" required>
          <option value="diagnosis">Diagnosis</option>
          <option value="implementation">Implementation</option>
          <option value="advisory">Advisory</option>
          <option value="unsure">Unsure</option>
        </select>
      </label>
      <label>
        Timeline
        <input name="timeline" required />
      </label>
      <label>
        Budget comfort
        <input name="budgetComfort" required />
      </label>
      <label class="contact-form__checkbox">
        <input name="consent" type="checkbox" value="true" required />
        I consent to being contacted about this inquiry.
      </label>
      <button type="submit">Submit inquiry</button>
      <p class="contact-form__fallback">
        Prefer email? Use <a href={`mailto:${viewModel.contactEmail}`}>{viewModel.contactEmail}</a>.
      </p>
    </form>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding: 0 0 var(--space-16);
  }

  .contact-form {
    display: grid;
    gap: var(--space-5);
    max-width: 760px;
  }

  .contact-form__availability,
  .contact-form__fallback {
    margin: 0;
    color: var(--color-muted);
  }

  label {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: var(--space-3);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
  }

  .contact-form__checkbox {
    display: flex;
    align-items: flex-start;
  }

  .contact-form__checkbox input {
    width: auto;
    margin-top: 0.35em;
  }

  button {
    min-height: 44px;
    width: fit-content;
    padding: var(--space-3) var(--space-5);
    color: #ffffff;
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-2);
    font-weight: 700;
  }
</style>
