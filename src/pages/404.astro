---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import type { Locale } from "@domain/site";
import { localePath, t } from "@i18n/locales";

const locale: Locale = Astro.url.pathname.startsWith("/vi") ? "vi" : "en";
const copy = t(locale).notFound;
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <PageHero
    title={copy.heading}
    summary={copy.summary}
    primaryCta={{ label: copy.goHome, href: localePath(locale, "/") }}
    secondaryCta={{ label: copy.contact, href: localePath(locale, "/contact") }}
  />
</BaseLayout>
