---
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import ContactIntake from "@islands/ContactIntake/ContactIntake.astro";
import { loadContactPageFromRepository } from "@programs/load-contact-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";
import type { Locale } from "@domain/site";
import { localePath, t } from "@i18n/locales";
import { localizeSiteMeta } from "@i18n/content";

const locale = (Astro.currentLocale ?? "en") as Locale;
const copy = t(locale);
const viewModel = await Effect.runPromise(
  loadContactPageFromRepository(astroContentRepository, locale)
);
const site = localizeSiteMeta(await Effect.runPromise(astroContentRepository.getSiteMeta), locale);
const seo = buildPageSeo(site, {
  path: localePath(locale, "/contact"),
  title: "Contact",
  description: copy.contact.seoDescription,
  ogImage: "/og/contact.svg"
});
---

<BaseLayout seo={seo} locale={locale} routePath="/contact">
  <PageHero title={viewModel.title} summary={viewModel.summary} />
  <section class="contact-section">
    <div class="u-container contact-layout">
      <ContactIntake viewModel={viewModel} locale={locale} />
      <aside class="fit-note" aria-labelledby="contact-boundaries">
        <h2 id="contact-boundaries">{copy.contact.beforeSending}</h2>
        <p>{copy.contact.fitNote}</p>
        <ul>{viewModel.nonFitCriteria.map((item) => <li>{item}</li>)}</ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    contain: layout style;
    padding: 0 0 var(--space-16);
  }

  .contact-layout {
    display: grid;
    gap: var(--space-8);
  }

  .fit-note {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .fit-note h2,
  .fit-note p {
    margin: 0;
  }

  .fit-note h2 {
    font-family: var(--font-body);
    font-size: 1.6rem;
    font-weight: 800;
  }

  .fit-note p,
  .fit-note ul {
    color: var(--color-muted);
  }

  @media (min-width: 980px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }
  }
</style>
