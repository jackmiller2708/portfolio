---
import { Effect } from "effect";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/primitives/ButtonLink/ButtonLink.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import HeroSystemMap from "@islands/HeroSystemMap/HeroSystemMap.astro";
import { loadCaseStudyPage } from "@programs/load-case-study-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";
import { localizeSiteMeta } from "@i18n/content";
import type { Locale } from "@domain/site";
import { localePath, t } from "@i18n/locales";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = (Astro.currentLocale ?? "en") as Locale;
const copy = t(locale);
const viewModel = await Effect.runPromise(loadCaseStudyPage(entry.id, locale));
const { caseStudy, systemMap } = viewModel;
const site = localizeSiteMeta(await Effect.runPromise(astroContentRepository.getSiteMeta), locale);
const seo = buildPageSeo(site, {
  path: localePath(locale, `/case-studies/${caseStudy.slug}`),
  title: caseStudy.title,
  description: caseStudy.summary,
  ogImage: "/og/case-studies.svg"
});
---

<BaseLayout seo={seo} locale={locale} routePath={`/case-studies/${caseStudy.slug}`}>
  <PageHero
    title={caseStudy.title}
    summary={caseStudy.summary}
    primaryCta={{ label: viewModel.cta.label, href: viewModel.cta.href }}
    secondaryCta={{ label: copy.common.backToCases, href: localePath(locale, "/case-studies") }}
  />
  <article class="case-detail">
    <div class="u-container case-detail__layout">
      <aside class="case-detail__meta" aria-label={copy.cases.context}>
        <p class="case-detail__label">{caseStudy.redactionStatus}</p>
        <h2>{copy.cases.context}</h2>
        <p>{caseStudy.context}</p>
      </aside>
      <div class="case-detail__main">
        <section class="scan-section" aria-labelledby="case-scan-title">
          <h2 id="case-scan-title">{copy.cases.caseScan}</h2>
          <div class="scan-grid">
            <article>
              <h3>{copy.home.problem}</h3>
              <p>{caseStudy.problem}</p>
            </article>
            <article>
              <h3>{copy.home.result}</h3>
              <p>{caseStudy.result}</p>
            </article>
            <article>
              <h3>{copy.cases.recommendation}</h3>
              <p>{caseStudy.recommendation}</p>
            </article>
          </div>
        </section>
        <section>
          <h2>{copy.cases.constraints}</h2>
          <ul>{caseStudy.constraints.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section>
          <h2>{copy.cases.decisions}</h2>
          <div class="detail-grid">
            {
              caseStudy.decisions.map((decision) => (
                <article class="detail-card">
                  <h3>{decision.title}</h3>
                  <p>{decision.rationale}</p>
                </article>
              ))
            }
          </div>
        </section>
        <section>
          <h2>{copy.cases.tradeoffs}</h2>
          <ul>{caseStudy.tradeoffs.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section>
          <h2>{copy.cases.beforeAfter}</h2>
          <div class="before-after">
            <article>
              <h3>{copy.cases.before}</h3>
              <ul>{caseStudy.beforeAfter.before.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <h3>{copy.cases.after}</h3>
              <ul>{caseStudy.beforeAfter.after.map((item) => <li>{item}</li>)}</ul>
            </article>
          </div>
        </section>
        <section aria-labelledby="case-system-map">
          <h2 id="case-system-map">{systemMap.title}</h2>
          <p>{systemMap.summary}</p>
          <HeroSystemMap map={systemMap} />
        </section>
        <section>
          <h2>{copy.cases.evidence}</h2>
          <div class="detail-grid">
            {
              caseStudy.evidence.map((item) => (
                <article class="detail-card">
                  <h3>{item.label}</h3>
                  <p>{item.detail}</p>
                </article>
              ))
            }
          </div>
        </section>
        <section class="case-detail__body">
          <Content />
        </section>
        {
          viewModel.recommendedReads.length > 0 && (
            <section class="recommended-reads" aria-labelledby="case-next-read">
              <h2 id="case-next-read">{copy.common.recommendedNextReads}</h2>
              <div class="recommended-grid">
                {viewModel.recommendedReads.map((read) => (
                  <a class="recommended-card" href={read.href}>
                    <span>{read.label}</span>
                    <h3>{read.title}</h3>
                    <p>{read.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        }
        <section class="case-detail__cta">
          <div>
            <h2>{viewModel.cta.title}</h2>
            <p>{viewModel.cta.summary}</p>
          </div>
          <ButtonLink href={viewModel.cta.href} label={viewModel.cta.label} />
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-detail {
    contain: layout style;
    padding: 0 0 var(--space-16);
  }

  .case-detail__layout {
    display: grid;
    gap: var(--space-8);
  }

  .case-detail__meta,
  .detail-card,
  .scan-grid > article,
  .before-after > article,
  .case-detail__cta,
  .recommended-card {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
    transition: border-color var(--duration-state) var(--ease-standard);
  }

  .detail-card:hover,
  .scan-grid > article:hover,
  .before-after > article:hover,
  .recommended-card:hover {
    border-color: var(--color-accent);
  }

  .case-detail__meta {
    align-self: start;
  }

  .case-detail__label {
    width: fit-content;
    padding: var(--space-1) var(--space-3);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    border-radius: var(--radius-1);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 700;
    text-transform: capitalize;
  }

  .case-detail__main,
  section,
  .detail-grid,
  .scan-grid,
  .before-after,
  .case-detail__cta,
  .recommended-grid {
    display: grid;
    gap: var(--space-5);
  }

  .case-detail__main {
    min-width: 0;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    font-family: var(--font-body);
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.12;
  }

  h3 {
    font-family: var(--font-body);
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.15;
  }

  p,
  li {
    color: var(--color-muted);
  }

  .recommended-card {
    color: inherit;
    text-decoration: none;
  }

  .recommended-card span {
    color: var(--color-accent);
    font-weight: 700;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .case-detail__body :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
  }

  .case-detail__body :global(p) {
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }

  @media (min-width: 980px) {
    .case-detail__layout {
      grid-template-columns: 320px minmax(0, 1fr);
    }

    .detail-grid,
    .scan-grid,
    .recommended-grid,
    .before-after {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-detail__cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
</style>
