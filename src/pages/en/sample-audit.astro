---
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/primitives/ButtonLink/ButtonLink.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import AuditFinding from "@components/organisms/AuditFinding/AuditFinding.astro";
import { loadSampleAuditPage } from "@programs/load-sample-audit-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";
import { localizeSiteMeta } from "@i18n/content";
import type { Locale } from "@domain/site";
import { localePath, t } from "@i18n/locales";

const locale = (Astro.currentLocale ?? "en") as Locale;
const copy = t(locale);
const viewModel = await Effect.runPromise(loadSampleAuditPage(locale));
const site = localizeSiteMeta(await Effect.runPromise(astroContentRepository.getSiteMeta), locale);
const seo = buildPageSeo(site, {
  path: localePath(locale, "/sample-audit"),
  title: viewModel.title,
  description: viewModel.summary,
  ogImage: "/og/sample-audit.svg"
});
const formatSeverity = (severity: string) => `${severity[0]?.toUpperCase()}${severity.slice(1)}`;
const firstWalkthrough = viewModel.walkthrough[0];
---

<BaseLayout seo={seo} locale={locale} routePath="/sample-audit">
  <PageHero
    title={viewModel.title}
    summary={viewModel.summary}
    primaryCta={{ label: copy.audit.primaryCta, href: localePath(locale, "/contact") }}
  />
  <section class="audit-section">
    <div class="u-container u-stack">
      {
        firstWalkthrough && (
          <section class="audit-walkthrough" aria-labelledby="audit-walkthrough-title">
            <div class="audit-walkthrough__header">
              <h2 id="audit-walkthrough-title">{copy.audit.guidedTitle}</h2>
              <p>{copy.audit.guidedSummary}</p>
            </div>
            <div class="audit-walkthrough__layout" data-audit-walkthrough>
              <div class="audit-walkthrough__findings" aria-label={copy.audit.findingsLabel}>
                {viewModel.walkthrough.map((step, index) => (
                  <button
                    class:list={["audit-walkthrough__finding", index === 0 && "is-active"]}
                    type="button"
                    aria-pressed={index === 0 ? "true" : "false"}
                    data-walkthrough-finding
                    data-title={step.title}
                    data-symptom={step.symptom}
                    data-evidence={step.evidence}
                    data-risk={step.risk}
                    data-recommendation={step.recommendation}
                    data-sprint={step.sprintTitle}
                  >
                    {step.title}
                  </button>
                ))}
              </div>
              <article class="audit-walkthrough__panel" aria-live="polite">
                <div
                  class="audit-walkthrough__phases"
                  role="group"
                  aria-label={copy.audit.phaseLabel}
                >
                  <button class="is-active" type="button" aria-pressed="true" data-phase="symptom">
                    {copy.audit.symptom}
                  </button>
                  <button type="button" aria-pressed="false" data-phase="evidence">
                    {copy.audit.evidence}
                  </button>
                  <button type="button" aria-pressed="false" data-phase="risk">
                    {copy.audit.risk}
                  </button>
                  <button type="button" aria-pressed="false" data-phase="recommendation">
                    {copy.audit.recommendation}
                  </button>
                  <button type="button" aria-pressed="false" data-phase="sprint">
                    {copy.audit.sprint}
                  </button>
                </div>
                <p class="audit-walkthrough__label" data-phase-label>
                  {copy.audit.symptom}
                </p>
                <h3 data-walkthrough-title>{firstWalkthrough.title}</h3>
                <p data-walkthrough-copy>{firstWalkthrough.symptom}</p>
                <ButtonLink
                  href={localePath(locale, "/contact?context=sample-audit")}
                  label={copy.audit.talk}
                />
                <details class="audit-walkthrough__static">
                  <summary>{copy.audit.readFull}</summary>
                  <dl>
                    <div>
                      <dt>{copy.audit.symptom}</dt>
                      <dd>{firstWalkthrough.symptom}</dd>
                    </div>
                    <div>
                      <dt>{copy.audit.evidence}</dt>
                      <dd>{firstWalkthrough.evidence}</dd>
                    </div>
                    <div>
                      <dt>{copy.audit.risk}</dt>
                      <dd>{firstWalkthrough.risk}</dd>
                    </div>
                    <div>
                      <dt>{copy.audit.recommendation}</dt>
                      <dd>{firstWalkthrough.recommendation}</dd>
                    </div>
                    <div>
                      <dt>{copy.audit.sprint}</dt>
                      <dd>{firstWalkthrough.sprintTitle}</dd>
                    </div>
                  </dl>
                </details>
              </article>
            </div>
          </section>
        )
      }
      <section class="full-report" aria-labelledby="full-report-title">
        <h2 id="full-report-title">{copy.audit.fullReportTitle}</h2>
        <p>{copy.audit.fullReportSummary}</p>
      </section>
      <div class="matrix-grid" aria-label={copy.audit.fullReportTitle}>
        {
          viewModel.riskMatrix.map((row) => (
            <article class="matrix-card">
              <p>{row.severity}</p>
              <strong>
                {row.count} {copy.audit.findings}
              </strong>
              <span>{row.areas.join(", ")}</span>
            </article>
          ))
        }
      </div>
      {
        viewModel.severityGroups.map((group) => (
          <section class="severity-group" aria-labelledby={`${group.severity}-findings`}>
            <h2 id={`${group.severity}-findings`}>{formatSeverity(group.severity)} severity</h2>
            <div class="finding-grid">
              {group.findings.map((finding) => (
                <AuditFinding finding={finding} />
              ))}
            </div>
          </section>
        ))
      }
      <section class="roadmap" aria-labelledby="audit-roadmap">
        <h2 id="audit-roadmap">{copy.audit.sprintRoadmap}</h2>
        <div class="roadmap-grid">
          {
            viewModel.roadmap.map((step) => (
              <article class="roadmap-card">
                <p>{step.title}</p>
                <ul>
                  {step.findings.map((finding) => (
                    <li>{finding.title}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>
      <section class="audit-cta" aria-labelledby="audit-cta-title">
        <div>
          <h2 id="audit-cta-title">{viewModel.cta.title}</h2>
          <p>{viewModel.cta.summary}</p>
        </div>
        <ButtonLink href={viewModel.cta.href} label={viewModel.cta.label} />
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .audit-section {
    contain: layout style;
    padding: 0 0 var(--space-16);
  }

  .audit-walkthrough,
  .full-report {
    display: grid;
    gap: var(--space-5);
  }

  .audit-walkthrough {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .audit-walkthrough__header,
  .audit-walkthrough__layout,
  .audit-walkthrough__findings,
  .audit-walkthrough__panel {
    display: grid;
    gap: var(--space-4);
  }

  .audit-walkthrough__header h2,
  .full-report h2,
  .audit-walkthrough__panel h3,
  .audit-walkthrough__header p,
  .full-report p,
  .audit-walkthrough__label,
  .audit-walkthrough__panel p {
    margin: 0;
  }

  .audit-walkthrough__header h2,
  .full-report h2,
  .audit-walkthrough__panel h3 {
    font-family: var(--font-body);
    font-weight: 800;
    line-height: 1.15;
  }

  .audit-walkthrough__header h2,
  .full-report h2 {
    font-size: var(--t-h2);
  }

  .audit-walkthrough__header p,
  .full-report p,
  .audit-walkthrough__panel p {
    color: var(--color-muted);
  }

  .audit-walkthrough__finding,
  .audit-walkthrough__phases button {
    min-height: 44px;
    padding: var(--control-padding-y) var(--control-padding-x);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
    cursor: pointer;
    font-weight: 700;
    line-height: 1.25;
    text-align: left;
    transition:
      background-color var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      color var(--duration-state) var(--ease-standard);
  }

  .audit-walkthrough__finding:hover,
  .audit-walkthrough__finding.is-active,
  .audit-walkthrough__phases button:hover,
  .audit-walkthrough__phases button.is-active {
    border-color: var(--color-accent);
  }

  .audit-walkthrough__panel {
    padding: var(--space-5);
    background: var(--color-surface-2);
    border: var(--border-1);
    border-radius: var(--radius-1);
    transition:
      border-color var(--duration-state) var(--ease-standard),
      opacity var(--duration-state) var(--ease-standard);
  }

  .audit-walkthrough__panel.is-updating {
    opacity: 0.72;
  }

  .audit-walkthrough__phases {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .audit-walkthrough__phases button {
    text-align: center;
    padding-top: 8px;
    line-height: 1;
  }

  .audit-walkthrough__label {
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 500;
    text-transform: uppercase;
  }

  .audit-walkthrough__static {
    padding-top: var(--space-4);
    border-top: var(--border-1);
  }

  .audit-walkthrough__static summary {
    cursor: pointer;
    font-weight: 700;
  }

  .audit-walkthrough__static dl {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }

  .audit-walkthrough__static dt {
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 500;
    text-transform: uppercase;
  }

  .audit-walkthrough__static dd {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
  }

  .matrix-grid,
  .finding-grid,
  .roadmap-grid {
    display: grid;
    gap: var(--space-5);
  }

  .matrix-card,
  .roadmap-card,
  .audit-cta {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .matrix-card {
    display: grid;
    gap: var(--space-2);
  }

  .matrix-card p,
  .matrix-card span,
  .roadmap-card p,
  .audit-cta h2,
  .audit-cta p {
    margin: 0;
  }

  .matrix-card p,
  .roadmap-card p {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: capitalize;
  }

  .matrix-card strong {
    font-size: var(--t-h3);
  }

  .matrix-card span,
  .audit-cta p {
    color: var(--color-muted);
  }

  .severity-group,
  .roadmap {
    display: grid;
    gap: var(--space-5);
  }

  .severity-group h2,
  .roadmap h2,
  .audit-cta h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.12;
  }

  .roadmap-card ul {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4) 0;
    color: var(--color-muted);
  }

  .audit-cta {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 760px) {
    .audit-walkthrough__layout {
      grid-template-columns: 280px minmax(0, 1fr);
      align-items: start;
    }

    .matrix-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .roadmap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .audit-cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
