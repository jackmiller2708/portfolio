---
import { Effect } from "effect";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/primitives/ButtonLink/ButtonLink.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import { loadLabPostPage } from "@programs/load-lab-post-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";
import { localizeSiteMeta } from "@i18n/content";
import type { Locale } from "@domain/site";
import { localePath, t } from "@i18n/locales";

export async function getStaticPaths() {
  const entries = await getCollection("lab-posts");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = (Astro.currentLocale ?? "en") as Locale;
const copy = t(locale);
const viewModel = await Effect.runPromise(loadLabPostPage(entry.id, locale));
const { post } = viewModel;
const site = localizeSiteMeta(await Effect.runPromise(astroContentRepository.getSiteMeta), locale);
const seo = buildPageSeo(site, {
  path: localePath(locale, `/lab/${post.slug}`),
  title: post.title,
  description: post.summary,
  ogImage: "/og/lab.svg"
});
---

<BaseLayout seo={seo} locale={locale} routePath={`/lab/${post.slug}`}>
  <PageHero
    title={post.title}
    summary={post.summary}
    primaryCta={{ label: copy.common.viewServices, href: localePath(locale, "/services") }}
    secondaryCta={{ label: copy.common.backToLab, href: localePath(locale, "/lab") }}
  />
  <article class="lab-detail">
    <div class="u-container lab-detail__layout">
      <aside class="lab-detail__meta" aria-label={copy.common.readNote}>
        <p class="lab-detail__topic">{post.topic}</p>
        <h2>{copy.common.takeaway}</h2>
        <p>{post.takeaway}</p>
        {
          post.codeLanguage && (
            <p>
              {copy.common.codeLanguage}: {post.codeLanguage}
            </p>
          )
        }
      </aside>
      <div class="lab-detail__body">
        <Content />
        {
          viewModel.relatedServices.length > 0 && (
            <section class="related-services">
              <h2>{copy.common.relatedServices}</h2>
              <div class="related-grid">
                {viewModel.relatedServices.map((service) => (
                  <article class="related-card">
                    <h3>{service.title}</h3>
                    <p>{service.summary}</p>
                    <ButtonLink
                      href={service.cta.href}
                      label={service.cta.label}
                      variant="secondary"
                    />
                  </article>
                ))}
              </div>
            </section>
          )
        }
        {
          viewModel.recommendedReads.length > 0 && (
            <section class="recommended-reads" aria-labelledby="lab-next-read">
              <h2 id="lab-next-read">{copy.common.recommendedNextReads}</h2>
              <div class="recommended-grid">
                {viewModel.recommendedReads.map((read) => (
                  <a class="recommended-card" href={read.href}>
                    <span>{read.label}</span>
                    <h3>{read.title}</h3>
                    <p>{read.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .lab-detail {
    contain: layout style;
    padding: 0 0 var(--space-16);
  }

  .lab-detail__layout {
    display: grid;
    gap: var(--space-8);
  }

  .lab-detail__meta,
  .related-card,
  .recommended-card {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
    transition: border-color var(--duration-state) var(--ease-standard);
  }

  .lab-detail__meta {
    display: grid;
    gap: var(--space-4);
    align-self: start;
  }

  .lab-detail__topic {
    width: fit-content;
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 700;
    text-transform: uppercase;
  }

  .lab-detail__meta h2,
  .lab-detail__meta p,
  .recommended-card h3,
  .recommended-card p,
  .related-card h3,
  .related-card p {
    margin: 0;
  }

  .lab-detail__body {
    min-width: 0;
    max-width: 820px;
  }

  .lab-detail__body :global(h2),
  .related-services h2,
  .recommended-reads h2 {
    margin: var(--space-8) 0 var(--space-3);
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .lab-detail__body :global(p),
  .lab-detail__meta p,
  .recommended-card p,
  .related-card p {
    color: var(--color-muted);
  }

  .lab-detail__body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .related-grid,
  .recommended-grid {
    display: grid;
    gap: var(--space-5);
  }

  .related-card,
  .recommended-card {
    display: grid;
    gap: var(--space-4);
  }

  .recommended-card {
    color: inherit;
    text-decoration: none;
  }

  .related-card:hover,
  .recommended-card:hover {
    border-color: var(--color-border-accent);
  }

  .recommended-card span {
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (min-width: 980px) {
    .lab-detail__layout {
      grid-template-columns: 280px minmax(0, 1fr);
    }

    .recommended-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
