---
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import { loadAboutPage } from "@programs/load-about-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";

const viewModel = await Effect.runPromise(loadAboutPage);
const site = await Effect.runPromise(astroContentRepository.getSiteMeta);
const seo = buildPageSeo(site, {
  path: "/about",
  title: viewModel.title,
  description: viewModel.summary
});
---

<BaseLayout seo={seo}>
  <PageHero
    title={viewModel.title}
    summary={viewModel.summary}
    primaryCta={{ label: "View services", href: "/services" }}
    secondaryCta={viewModel.cta}
  />
  <section class="about-section">
    <div class="u-container about-grid">
      <article class="about-panel about-panel--lead">
        <h2>Short version</h2>
        <p>{viewModel.about.context}</p>
        <dl class="snapshot-list">
          <div>
            <dt>Name</dt>
            <dd>Nguyen Ngoc Huy</dd>
          </div>
          <div>
            <dt>Also called</dt>
            <dd>Jack by English-speaking teams</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>Angular Frontend Systems Engineer</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>Vietnam</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${viewModel.contactEmail}`}>{viewModel.contactEmail}</a>
            </dd>
          </div>
        </dl>
      </article>
      <article class="about-panel about-panel--lead">
        <h2>What I protect in frontend systems</h2>
        <p>{viewModel.about.philosophy}</p>
      </article>
      <article class="about-panel">
        <h2>What I work on</h2>
        {viewModel.about.qualityPhilosophy.map((item) => <p>{item}</p>)}
      </article>
      <article class="about-panel">
        <h2>How I work</h2>
        {viewModel.about.workingStyle.map((item) => <p>{item}</p>)}
      </article>
      <article class="about-panel">
        <h2>What I will not do</h2>
        {viewModel.nonFitCriteria.map((item) => <p>{item}</p>)}
      </article>
    </div>
  </section>
  <section class="about-section about-section--compact">
    <div class="u-container communication">
      <h2>Communication</h2>
      <p>{viewModel.about.communication}</p>
      <p>
        For Angular audit, refactor, or architecture inquiries, email me at <a
          href={`mailto:${viewModel.contactEmail}`}>{viewModel.contactEmail}</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-section {
    contain: layout style;
    padding: 0 0 var(--space-16);
  }

  .about-section--compact {
    padding-top: 0;
  }

  .about-grid {
    display: grid;
    gap: var(--space-6);
  }

  .about-panel,
  .communication {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .about-panel {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .about-panel h2,
  .about-panel p,
  .snapshot-list,
  .snapshot-list dd {
    margin: 0;
  }

  .about-panel h2 {
    font-family: var(--font-body);
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.12;
  }

  .about-panel p {
    color: var(--color-muted);
  }

  .snapshot-list {
    display: grid;
    gap: var(--space-3);
  }

  .snapshot-list div {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: var(--border-1);
  }

  .snapshot-list dt {
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--t-mono);
    font-weight: 500;
  }

  .snapshot-list dd {
    color: var(--color-text);
  }

  .communication {
    display: grid;
    gap: var(--space-3);
    max-width: 760px;
  }

  .communication h2,
  .communication p {
    margin: 0;
  }

  .communication h2 {
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: 800;
  }

  .communication p {
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-panel--lead {
      grid-column: 1 / -1;
      max-width: 860px;
    }
  }
</style>
