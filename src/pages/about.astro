---
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import { loadAboutPage } from "@programs/load-about-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";

const viewModel = await Effect.runPromise(loadAboutPage);
const site = await Effect.runPromise(astroContentRepository.getSiteMeta);
const seo = buildPageSeo(site, {
  path: "/about",
  title: viewModel.title,
  description: viewModel.summary
});
---

<BaseLayout seo={seo}>
  <PageHero
    title="Practical frontend architecture under real delivery constraints."
    summary={viewModel.about.context}
    primaryCta={{ label: "View services", href: "/services" }}
    secondaryCta={viewModel.cta}
  />
  <section class="about-section">
    <div class="u-container about-grid">
      <article class="about-panel about-panel--lead">
        <h2>What good frontend work protects</h2>
        <p>{viewModel.about.philosophy}</p>
      </article>
      <article class="about-panel">
        <h2>How I work</h2>
        {viewModel.about.workingStyle.map((item) => <p>{item}</p>)}
      </article>
      <article class="about-panel">
        <h2>What I will not do</h2>
        {viewModel.nonFitCriteria.map((item) => <p>{item}</p>)}
      </article>
    </div>
  </section>
  <section class="about-section about-section--compact">
    <div class="u-container communication">
      <h2>Communication</h2>
      <p>{viewModel.about.communication}</p>
      <p>
        Direct fallback: <a href={`mailto:${viewModel.contactEmail}`}>{viewModel.contactEmail}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-section {
    padding: 0 0 var(--space-16);
  }

  .about-section--compact {
    padding-top: 0;
  }

  .about-grid {
    display: grid;
    gap: var(--space-6);
  }

  .about-panel,
  .communication {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .about-panel {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .about-panel h2,
  .about-panel p {
    margin: 0;
  }

  .about-panel h2 {
    font-family: var(--font-body);
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.12;
  }

  .about-panel p {
    color: var(--color-muted);
  }

  .communication {
    display: grid;
    gap: var(--space-3);
    max-width: 760px;
  }

  .communication h2,
  .communication p {
    margin: 0;
  }

  .communication h2 {
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: 800;
  }

  .communication p {
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-panel--lead {
      grid-column: 1 / -1;
      max-width: 860px;
    }
  }
</style>
