---
import { Effect } from "effect";
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/primitives/ButtonLink/ButtonLink.astro";
import PageHero from "@components/sections/PageHero/PageHero.astro";
import { loadLabPostPage } from "@programs/load-lab-post-page";
import { astroContentRepository } from "@services/AstroContentRepository";
import { buildPageSeo } from "@utils/seo";

export async function getStaticPaths() {
  const entries = await getCollection("lab-posts");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const viewModel = await Effect.runPromise(loadLabPostPage(entry.id));
const { post } = viewModel;
const site = await Effect.runPromise(astroContentRepository.getSiteMeta);
const seo = buildPageSeo(site, {
  path: `/lab/${post.slug}`,
  title: post.title,
  description: post.summary
});
---

<BaseLayout seo={seo}>
  <PageHero
    title={post.title}
    summary={post.summary}
    primaryCta={{ label: "View services", href: "/services" }}
    secondaryCta={{ label: "Back to lab", href: "/lab" }}
  />
  <article class="lab-detail">
    <div class="u-container lab-detail__layout">
      <aside class="lab-detail__meta" aria-label="Lab post metadata">
        <p class="lab-detail__topic">{post.topic}</p>
        <h2>Takeaway</h2>
        <p>{post.takeaway}</p>
        {post.codeLanguage && <p>Code language: {post.codeLanguage}</p>}
      </aside>
      <div class="lab-detail__body">
        <Content />
        {
          viewModel.relatedServices.length > 0 && (
            <section class="related-services">
              <h2>Related services</h2>
              <div class="related-grid">
                {viewModel.relatedServices.map((service) => (
                  <article class="related-card">
                    <h3>{service.title}</h3>
                    <p>{service.summary}</p>
                    <ButtonLink
                      href={service.cta.href}
                      label={service.cta.label}
                      variant="secondary"
                    />
                  </article>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .lab-detail {
    padding: 0 0 var(--space-16);
  }

  .lab-detail__layout {
    display: grid;
    gap: var(--space-8);
  }

  .lab-detail__meta,
  .related-card {
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .lab-detail__meta {
    display: grid;
    gap: var(--space-4);
    align-self: start;
  }

  .lab-detail__topic {
    width: fit-content;
    margin: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .lab-detail__meta h2,
  .lab-detail__meta p,
  .related-card h3,
  .related-card p {
    margin: 0;
  }

  .lab-detail__body {
    min-width: 0;
    max-width: 820px;
  }

  .lab-detail__body :global(h2),
  .related-services h2 {
    margin: var(--space-8) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.15;
  }

  .lab-detail__body :global(p),
  .lab-detail__meta p,
  .related-card p {
    color: var(--color-muted);
  }

  .lab-detail__body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .related-grid {
    display: grid;
    gap: var(--space-5);
  }

  .related-card {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 980px) {
    .lab-detail__layout {
      grid-template-columns: 280px minmax(0, 1fr);
    }
  }
</style>
