---
import type { ContactPageViewModel } from "@programs/load-contact-page";
import type { Locale } from "@domain/site";

type Props = {
  viewModel: ContactPageViewModel;
  locale?: Locale;
};

const { viewModel, locale = "en" } = Astro.props;
const firstRecommendation = viewModel.advisoryRecommendations[0];
const formCopy =
  locale === "vi"
    ? {
        advisoryTitle: "Điều tôi sẽ hỏi trước",
        advisorySummary:
          "Chọn điểm đau gần nhất. Đề xuất sẽ giữ inquiry đầu tiên gắn với rủi ro hệ thống Angular.",
        advisoryOptions: "Điểm bắt đầu advisory",
        recommendedStep: "Bước đầu đề xuất",
        useContext: "Dùng ngữ cảnh này",
        framing:
          "Chia sẻ ngữ cảnh sản phẩm, phiên bản Angular, quy mô đội, điểm đau hiện tại, và timeline.",
        name: "Tên",
        email: "Email",
        productContext: "Ngữ cảnh sản phẩm",
        angularVersion: "Phiên bản Angular hoặc frontend stack",
        teamSize: "Quy mô đội",
        timeline: "Timeline",
        budgetComfort: "Mức ngân sách thoải mái - tùy chọn",
        pain: "Hiện tại điều gì đang đau?",
        engagementType: "Bạn cần diagnosis, implementation, hay cả hai?",
        diagnosis: "Diagnosis",
        implementation: "Implementation",
        advisory: "Advisory",
        unsure: "Chưa chắc",
        consent: "Tôi đồng ý được liên hệ về inquiry này.",
        submit: "Gửi inquiry",
        emailFallback: "Thích email hơn? Dùng",
        requiredHint: "Các trường có dấu * là bắt buộc."
      }
    : {
        advisoryTitle: "What I would ask first",
        advisorySummary:
          "Pick the closest pain. The recommendation keeps the first inquiry scoped to the Angular system risk.",
        advisoryOptions: "Advisory starting points",
        recommendedStep: "Recommended first step",
        useContext: "Use this context",
        framing:
          "Share the product context, Angular version, team size, current pain, and timeline.",
        name: "Name",
        email: "Email",
        productContext: "Product context",
        angularVersion: "Angular version or frontend stack",
        teamSize: "Team size",
        timeline: "Timeline",
        budgetComfort: "Budget comfort - optional",
        pain: "What currently feels painful?",
        engagementType: "Do you need diagnosis, implementation, or both?",
        diagnosis: "Diagnosis",
        implementation: "Implementation",
        advisory: "Advisory",
        unsure: "Unsure",
        consent: "I consent to being contacted about this inquiry.",
        submit: "Submit inquiry",
        emailFallback: "Prefer email? Use",
        requiredHint: "Fields marked * are required."
      };
const fields = [
  {
    id: "name",
    label: formCopy.name,
    autocomplete: "name"
  },
  {
    id: "email",
    label: formCopy.email,
    type: "email",
    autocomplete: "email"
  },
  {
    id: "productContext",
    label: formCopy.productContext
  },
  {
    id: "angularVersion",
    label: formCopy.angularVersion
  },
  {
    id: "teamSize",
    label: formCopy.teamSize
  },
  {
    id: "timeline",
    label: formCopy.timeline
  },
  {
    id: "budgetComfort",
    label: formCopy.budgetComfort,
    required: false
  }
] as const;
---

<div class="contact-intake">
  {
    firstRecommendation && (
      <section class="advisory-flow" aria-labelledby="advisory-flow-title" data-advisory-flow>
        <div>
          <h2 id="advisory-flow-title">{formCopy.advisoryTitle}</h2>
          <p>{formCopy.advisorySummary}</p>
        </div>
        <div class="advisory-flow__layout">
          <div class="advisory-flow__options" aria-label={formCopy.advisoryOptions}>
            {viewModel.advisoryRecommendations.map((recommendation, index) => (
              <button
                class:list={["advisory-flow__option", index === 0 && "is-active"]}
                type="button"
                aria-pressed={index === 0 ? "true" : "false"}
                data-advisory-option
                data-id={recommendation.id}
                data-label={recommendation.label}
                data-pain={recommendation.pain}
                data-service-title={recommendation.recommendedServiceTitle}
                data-reason={recommendation.reason}
                data-contact-href={recommendation.contactHref}
              >
                <span>{recommendation.label}</span>
                <small>{recommendation.pain}</small>
              </button>
            ))}
          </div>
          <article class="advisory-flow__result" aria-live="polite">
            <p class="advisory-flow__label">{formCopy.recommendedStep}</p>
            <h3 data-advisory-title>{firstRecommendation.recommendedServiceTitle}</h3>
            <p data-advisory-reason>{firstRecommendation.reason}</p>
            <a href={firstRecommendation.contactHref} data-advisory-link>
              {formCopy.useContext}
            </a>
          </article>
        </div>
      </section>
    )
  }

  <form class="contact-form" method="post" aria-describedby="contact-fallback" data-astro-reload>
    <p class="contact-form__framing">
      {formCopy.framing}
    </p>
    <p class="contact-form__availability">{viewModel.availability}</p>
    <p class="contact-form__required-hint">{formCopy.requiredHint}</p>
    {
      fields.map((field) => {
        const isRequired = !("required" in field) || field.required;
        return (
          <label for={field.id}>
            {field.label}
            {isRequired && (
              <span class="required-indicator" aria-hidden="true">
                {" "}
                *
              </span>
            )}
            <input
              id={field.id}
              name={field.id}
              type={"type" in field ? field.type : "text"}
              autocomplete={"autocomplete" in field ? field.autocomplete : undefined}
              required={isRequired}
            />
          </label>
        );
      })
    }
    <label for="pain">
      {formCopy.pain}
      <span class="required-indicator" aria-hidden="true">
        {" "}
        *
      </span>
      <textarea id="pain" name="pain" rows="5" required></textarea>
    </label>
    <label for="engagementType">
      {formCopy.engagementType}
      <span class="required-indicator" aria-hidden="true">
        {" "}
        *
      </span>
      <select id="engagementType" name="engagementType" required>
        <option value="diagnosis">{formCopy.diagnosis}</option>
        <option value="implementation">{formCopy.implementation}</option>
        <option value="advisory">{formCopy.advisory}</option>
        <option value="unsure">{formCopy.unsure}</option>
      </select>
    </label>
    <label class="contact-form__checkbox" for="consent">
      <input id="consent" name="consent" type="checkbox" value="true" required />
      {formCopy.consent}
      <span class="required-indicator" aria-hidden="true"> *</span>
    </label>
    <button type="submit">{formCopy.submit}</button>
    <p id="contact-fallback" class="contact-form__fallback">
      {formCopy.emailFallback}
      <a href={`mailto:${viewModel.contactEmail}`}>{viewModel.contactEmail}</a>.
    </p>
  </form>
</div>

<style>
  .contact-intake {
    display: grid;
    gap: var(--space-8);
    max-width: 900px;
  }

  .advisory-flow {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .advisory-flow h2,
  .advisory-flow h3,
  .advisory-flow p {
    margin: 0;
  }

  .advisory-flow h2,
  .advisory-flow h3 {
    font-family: var(--font-body);
    font-weight: 800;
    line-height: 1.15;
  }

  .advisory-flow p,
  .advisory-flow small {
    color: var(--color-muted);
  }

  .advisory-flow__layout,
  .advisory-flow__options,
  .advisory-flow__result {
    display: grid;
    gap: var(--space-4);
  }

  .advisory-flow__option {
    display: grid;
    gap: var(--space-2);
    min-height: 96px;
    padding: var(--space-4);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
    cursor: pointer;
    text-align: left;
    transition:
      background-color var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      color var(--duration-state) var(--ease-standard);
  }

  .advisory-flow__option:hover,
  .advisory-flow__option.is-active {
    background: var(--color-accent-dim);
    border-color: var(--color-accent);
  }

  .advisory-flow__option span,
  .advisory-flow__label,
  .advisory-flow__result a {
    font-weight: 700;
  }

  .advisory-flow__option small {
    font-size: 0.95rem;
  }

  .advisory-flow__result {
    padding: var(--space-5);
    background: var(--color-surface-2);
    border: var(--border-1);
    border-radius: var(--radius-1);
    transition:
      border-color var(--duration-state) var(--ease-standard),
      opacity var(--duration-state) var(--ease-standard);
  }

  .advisory-flow__result.is-updating {
    opacity: 0.72;
  }

  .advisory-flow__label {
    color: var(--color-accent);
  }

  .advisory-flow__result a {
    color: var(--color-text);
  }

  .contact-form {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-2);
  }

  .contact-form__framing,
  .contact-form__availability,
  .contact-form__fallback {
    margin: 0;
    color: var(--color-muted);
  }

  .contact-form__framing {
    color: var(--color-text);
    font-weight: 700;
  }

  .contact-form__required-hint {
    font-size: var(--t-small);
  }

  label {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
  }

  .required-indicator {
    color: var(--color-danger);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 44px;
    padding: var(--space-3);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-1);
    border-radius: var(--radius-1);
    transition:
      background-color var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      color var(--duration-state) var(--ease-standard);
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  .contact-form__checkbox {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .contact-form__checkbox input {
    width: auto;
    min-height: 0;
    margin-top: 0.35em;
  }

  button {
    min-height: 44px;
    width: fit-content;
    padding: var(--control-padding-y) var(--control-padding-x);
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-1);
    cursor: pointer;
    font-weight: 700;
    transition:
      background-color var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      color var(--duration-state) var(--ease-standard);
  }

  @media (min-width: 760px) {
    .advisory-flow__layout {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 0.85fr);
      align-items: start;
    }
  }
</style>
